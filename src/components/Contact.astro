---
interface Props {
    title: string;
    link: string;
}

const { title, link } = Astro.props;
---

<a href={link}>
    <span>→</span>
    {title}
</a>

<style>
    span {
        color: var(--text-dim);
    }

    a {
        font-family: var(--font-mono);
        text-decoration: none;
        font-size: var(--step--1);
        display: flex;
        align-items: baseline;
        gap: 0.5em;
        padding: 0.5vw;
        color: var(--text-muted);
        border-bottom: 1px solid var(--rule);
        transition: color 0.15s;
    }
</style>
