---
interface Props {
    title: string;
    link: string;
}

const { title, link } = Astro.props;
---

<a href={link}>
    <span>→</span>
    {title}
</a>

<style>
    span {
        color: var(--text-dim);
        transition: color 0.15s ease;
    }

    a {
        font-family: var(--font-mono);
        text-decoration: none;
        font-size: var(--step--1);
        display: flex;
        align-items: baseline;
        gap: 0.5em;
        padding-block: 0.6rem;
        padding-inline: 0.25vw;
        color: var(--text-muted);
        border-bottom: 1px solid var(--rule);
        transition:
            color 0.15s ease,
            border-color 0.15s ease;
    }

    a:hover,
    a:focus-visible {
        color: var(--accent);
        border-bottom-color: var(--accent-rule);
    }

    a:hover span,
    a:focus-visible span {
        color: inherit;
    }

    a:focus-visible {
        outline: 1px solid var(--accent-rule);
        outline-offset: 0.15em;
    }
</style>
