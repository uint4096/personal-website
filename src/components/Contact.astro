---
interface Props {
    title: string;
    link: string;
}

const { title, link } = Astro.props;
---

<a href={link}>
    <span>→</span>
    {title}
</a>

<style>
    span {
        color: oklch(0.5 0.01 70);
    }

    a {
        font-family: "JetBrains Mono", monospace;
        text-decoration: none;
        font-size: clamp(0.4rem, 0.5rem + 0.3vw, 2rem);
        display: flex;
        align-items: baseline;
        gap: 0.5em;
        padding: 0.5vw;
        color: oklch(0.72 0.012 80);
        border-bottom: 1px solid oklch(0.25 0.0008 50);
        transition: color 0.15s;
    }
</style>
