---
interface Props {
    variant?: "default" | "muted";
}

const { variant = "default" } = Astro.props;
---

<p class={variant}><slot /></p>

<style>
    p {
        font-size: var(--step-0);
        line-height: 1.62;
        letter-spacing: -0.004em;
    }
    .default {
        color: var(--text);
    }
    .muted {
        color: var(--text-muted);
    }
</style>
