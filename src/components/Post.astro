---
import type { InferEntrySchema } from "astro:content";
import { formatTime } from "@helpers/format-time";

interface Props extends InferEntrySchema<"blog"> {
    id: string;
}

const { date, title, id } = Astro.props;
const formatted = formatTime(date);
---

<article>
    <h3><a href=`/blog/${id}`>{title}</a></h3>
    <time datetime={date.toISOString()}>{formatted}</time>
</article>

<style>
    article {
        padding-block: 1.75rem;
        border-top: 1px solid var(--rule);
        transition: border-color 0.15s ease;
    }
    article:last-child {
        border-bottom: 1px solid var(--rule);
    }
    article:has(a:hover),
    article:has(a:focus-visible) {
        border-color: var(--accent-rule);
    }
    article:has(a:hover) + article,
    article:has(a:focus-visible) + article {
        border-top-color: var(--accent-rule);
    }
    h3 {
        margin: 0;
        font-size: var(--step-2);
        font-weight: 400;
        line-height: 1.25;
        letter-spacing: -0.01em;
        color: var(--text-strong);
    }
    a {
        color: inherit;
        text-decoration: none;
        transition: color 0.15s ease;
    }
    a:hover,
    a:focus-visible {
        color: var(--accent);
    }
    a:focus-visible {
        outline: 1px solid var(--accent-rule);
        outline-offset: 0.35em;
    }
    time {
        display: block;
        margin-block-start: 0.7rem;
        font-family: var(--font-mono);
        font-size: var(--step--2);
        letter-spacing: 0.08em;
        color: var(--text-dim);
    }
</style>
