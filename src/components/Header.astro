---
interface Props {
    name: string;
}

const { name } = Astro.props;
---

<h1>{name}</h1>

<style>
    h1 {
        font-weight: 400;
        font-size: clamp(4rem, 2.2rem + 0.9vw, 3.8rem);
        line-height: 1;
        margin: 0px;
        letter-spacing: -0.02em;
        color: oklch(0.95 0.012 85);
    }
</style>
