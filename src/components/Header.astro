---
interface Props {
    name: string;
}

const { name } = Astro.props;
---

<h1>{name}</h1>

<style>
    h1 {
        font-weight: 400;
        font-size: var(--step-4);
        line-height: 1;
        margin: 0px;
        letter-spacing: -0.02em;
        color: var(--text-strong);
    }
</style>
