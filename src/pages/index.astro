---
import type { ComponentProps } from "astro/types";

import BaseLayout from "@layouts/BaseLayout.astro";

import Header from "@components/Header.astro";
import Para from "@components/Para.astro";
import Contact from "@components/Contact.astro";

import Arrow from "../assets/arrow.svg";

const NAME = "Abhishek Kumar";

const contacts: Array<ComponentProps<typeof Contact>> = [
    {
        title: "GitHub",
        link: "https://github.com/uint4096",
    },
    {
        title: "LinkedIn",
        link: "https://linkedin.com/in/abhishek-kr7",
    },
    {
        title: "Email",
        link: "https://mail.google.com/mail/?view=cm&fs=1&to=abhishek.725x@gmail.com",
    },
    {
        title: "Résumé",
        link: "https://drive.google.com/file/d/1bGwYtS5pRad5FU64S1TLQXo_RI-5OVln/view?usp=sharing",
    },
];
---

<BaseLayout title={NAME}>
    <div>
        <section class="intro">
            <Header name={NAME} />
            <section>
                <Para>
                    <span>
                        I'm a software engineer with over 8 years in the
                        industry. I build scalable and reliable distributed
                        systems, with a focus on backend and platform
                        engineering.
                    </span>
                </Para>
                <Para>
                    <span>
                        These days I'm helping build <a href="https://fyxer.com"
                            >Fyxer</a
                        >.
                    </span>
                </Para>
                <Para colorOverride="oklch(0.74 0.012 80)">
                    When I'm not working, I like making things, reading, and
                    writing (check out my <a href="#writing">blog</a>
                    <span class="arrow"><Arrow /></span>)</Para
                >
            </section>
            <section>
                <h5>Contact and Socials</h5>
                {
                    contacts.map(({ title, link }) => (
                        <Contact title={title} link={link} />
                    ))
                }
            </section>
        </section>
    </div>
</BaseLayout>

<style>
    div {
        display: grid;
        padding: clamp(7vh, 10vh, 12vh) 23%;
        grid-template-columns: minmax(0px, 1.28fr) minmax(0px, 0.9fr);
        max-height: 100vh;
        gap: clamp(4vw, 8vw, 12vw);
        margin: 0px auto;
    }
    .intro {
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
    }
    a {
        color: oklch(0.82 0.11 60);
        border-bottom: 1px solid oklch(0.82 0.11 60 / 0.35);
        text-decoration: none;
    }
    .arrow {
        display: inline-flex;
        align-items: center;
        margin-left: 0.2em;
        color: oklch(0.82 0.11 60);
        transform: translateY(3px);
    }
    h5 {
        font-family: "JetBrains Mono", monospace;
        font-size: clamp(0.4rem, 0.4rem + 0.3vw, 2rem);
        letter-spacing: 0.18em;
        text-transform: uppercase;
        color: oklch(0.58 0.01 70);
    }
</style>
