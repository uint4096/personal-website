---
import type { ComponentProps } from "astro/types";
import { getCollection } from "astro:content";

import BaseLayout from "@layouts/BaseLayout.astro";

import Header from "@components/Header.astro";
import Para from "@components/Para.astro";
import Contact from "@components/Contact.astro";

import Arrow from "../assets/arrow.svg";
import Post from "@components/Post.astro";

const NAME = "Abhishek Kumar";

const contacts: Array<ComponentProps<typeof Contact>> = [
    {
        title: "GitHub",
        link: "https://github.com/uint4096",
    },
    {
        title: "LinkedIn",
        link: "https://linkedin.com/in/abhishek-kr7",
    },
    {
        title: "Email",
        link: "https://mail.google.com/mail/?view=cm&fs=1&to=abhishek.725x@gmail.com",
    },
    {
        title: "Résumé",
        link: "https://drive.google.com/file/d/1bGwYtS5pRad5FU64S1TLQXo_RI-5OVln/view?usp=sharing",
    },
];

const blog = await getCollection("blog");
const posts = blog.sort(
    (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
---

<BaseLayout title={NAME}>
    <div class="layout">
        <section class="intro">
            <Header name={NAME} />
            <section>
                <Para>
                    <span>
                        I'm a software engineer with over 8 years in the
                        industry. I build scalable and reliable distributed
                        systems, with a focus on backend and platform
                        engineering.
                    </span>
                </Para>
                <Para>
                    <span>
                        These days I'm helping build <a href="https://fyxer.com"
                            >Fyxer</a
                        >.
                    </span>
                </Para>
                <Para variant="muted">
                    When I'm not working, I like making things, reading, and
                    writing (check out my blog
                    <span class="arrow"><Arrow /></span>)</Para
                >
            </section>
            <section>
                <h5>Contact and Socials</h5>
                {
                    contacts.map(({ title, link }) => (
                        <Contact title={title} link={link} />
                    ))
                }
            </section>
        </section>
        <section class="writing" id="writing">
            <h5>Writing</h5>
            <div class="posts">
                {posts.map((post) => <Post {...post.data} id={post.id} />)}
            </div>
        </section>
    </div>
</BaseLayout>

<style>
    .layout {
        flex: 1;
        min-height: 0;
        display: grid;
        grid-template-columns: minmax(0px, 1.14fr) minmax(0px, 1fr);
        gap: clamp(2rem, 9vw, 11rem);
        width: 100%;
        max-width: var(--measure);
        margin-inline: auto;
        padding-block: var(--pad-block);
        padding-inline: var(--gutter);
    }
    .intro {
        display: flex;
        flex-direction: column;
        align-self: start;
        gap: 1.5rem;
    }
    a {
        color: var(--accent);
        border-bottom: 1px solid var(--accent-rule);
        text-decoration: none;
    }
    .arrow {
        display: inline-flex;
        align-items: center;
        margin-left: 0.2em;
        color: var(--accent);
        transform: translateY(3px);
    }
    h5 {
        font-family: var(--font-mono);
        font-size: var(--step--2);
        letter-spacing: 0.18em;
        text-transform: uppercase;
        color: var(--text-faint);
    }
</style>
